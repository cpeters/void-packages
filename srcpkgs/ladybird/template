do_configure() {
	export VCPKG_ROOT="${wrksrc}/Build/vcpkg-distribution"
	export VCPKG_MAX_CONCURRENCY="${XBPS_MAKEJOBS}"

	# Bootstrap upstream's pinned vcpkg environment.
	python3 Meta/ladybird.py vcpkg --preset Distribution

	# Use upstream's distribution configuration with private
	# bundled dependencies and a baseline CPU target.
	cmake --preset Distribution \
		-DCMAKE_INSTALL_PREFIX=/opt/ladybird \
		-DLADYBIRD_BUILD_QT=ON \
		-DLADYBIRD_VERSION="${version}" \
		-DENABLE_INSTALL_HEADERS=OFF \
		-DLADYBIRD_ENABLE_UPDATE_CHECK=OFF \
		-DLADYBIRD_GENERATE_SYMBOL_FILES=OFF \
		-DCMAKE_LINKER_TYPE=MOLD
}

do_build() {
	cmake --build --preset Distribution \
		--parallel "${XBPS_MAKEJOBS}"
}

do_install() {
	DESTDIR="${DESTDIR}" cmake --install Build/distribution

	# Remove static libraries not required at runtime.
	rm -f "${DESTDIR}/opt/ladybird/lib64/"*.a

	# Install the command-line launcher.
	vbin "${FILESDIR}/ladybird"

	# Update upstream desktop integration to use the launcher.
	sed -i 's|^Exec=Ladybird|Exec=/usr/bin/ladybird|' \
		"${DESTDIR}/opt/ladybird/share/applications/org.ladybird.Ladybird.desktop" \
		"${DESTDIR}/opt/ladybird/share/dbus-1/services/org.ladybird.Ladybird.service"

	# Install desktop integration into standard system paths.
	vinstall "${DESTDIR}/opt/ladybird/share/applications/org.ladybird.Ladybird.desktop" \
		644 usr/share/applications

	vinstall "${DESTDIR}/opt/ladybird/share/dbus-1/services/org.ladybird.Ladybird.service" \
		644 usr/share/dbus-1/services

	vinstall "${DESTDIR}/opt/ladybird/share/icons/hicolor/scalable/apps/org.ladybird.Ladybird.svg" \
		644 usr/share/icons/hicolor/scalable/apps

	vinstall "${DESTDIR}/opt/ladybird/share/metainfo/org.ladybird.Ladybird.metainfo.xml" \
		644 usr/share/metainfo

	# Install the upstream license.
	vlicense LICENSE
}
